# ==============================================================================
# EpiBrother Environment Configuration Template (.env.example)
# Duplicate this file to .env and set your real secrets and credentials.
# The .env file must NEVER be committed to version control.
# ==============================================================================

# Database Configuration
POSTGRES_DB=epibrother
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/epibrother
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# JWT Authentication Secret
# MUST be a cryptographically strong secret of at least 256 bits (32 bytes / characters)
JWT_SECRET=replace_with_256_bit_random_string_in_your_local_env_file
JWT_EXPIRATION_MS=86400000

# Default Seed Accounts (used solely by DataInitializer on first boot)
DEFAULT_ADMIN_PASSWORD=your_admin_password_here
DEFAULT_MANAGER_PASSWORD=your_manager_password_here
DEFAULT_ALICE_PASSWORD=your_alice_password_here
DEFAULT_BOB_PASSWORD=your_bob_password_here
