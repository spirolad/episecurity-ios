# ==============================================================================
# EpiBrother Docker Environment Configuration Template (.env.docker.example)
# Duplicate this file to .env.docker and adjust credentials if needed.
# ==============================================================================

# Database Configuration
POSTGRES_DB=epibrother
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/epibrother
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Authentication Secret (cryptographically strong 256+ bit key)
JWT_SECRET=epibrotherProductionGradeSecureJwtTokenSecretKey2026WithMinimum256BitsOfEntropy!
JWT_EXPIRATION_MS=86400000

# Default Seed Accounts (used solely by DataInitializer on first boot)
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_MANAGER_PASSWORD=manager123
DEFAULT_ALICE_PASSWORD=alice123
DEFAULT_BOB_PASSWORD=bob123
